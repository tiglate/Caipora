# Loaded automatically by the application (and by Docker Compose) when present in the working directory.
# Real environment variables take precedence. Use plain KEY=value lines (no quotes, no "export").

# Database connection
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=caipora
DATABASE_USERNAME=caipora
DATABASE_PASSWORD=change_me

# Security
# Initial password of the "admin" account (>= 8 chars). Used only when no administrator exists (e.g. a fresh
# database); it must be changed at the first sign-in. Can be removed afterwards.
ADMIN_INITIAL_PASSWORD=
# Secret that signs "remember me" cookies; generate with: openssl rand -base64 48
REMEMBER_ME_KEY=
# Set to true when the application is served over HTTPS
COOKIE_SECURE=false
# Behind a reverse proxy, set to "native" or "framework" so the real client address is used (login throttling)
# FORWARD_HEADERS_STRATEGY=native

# Directory where uploaded version packages are stored
# UPLOAD_DIRECTORY=/var/lib/caipora/uploads   (default: ~/caipora/uploads)
